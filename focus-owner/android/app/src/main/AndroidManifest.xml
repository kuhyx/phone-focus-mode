<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Required to start the pass with foregroundServiceType="location".
         Without it startForeground throws SecurityException and the whole
         service crashes on every alarm; measured 2026-08-14. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- USE_EXACT_ALARM rather than SCHEDULE_EXACT_ALARM: the latter is
         user-revocable and was observed denied by default on Android 16,
         which turned a curfew boundary into a +26 minute window. This app's
         whole function is acting at specific times, which is the documented
         qualifying use, and it is granted at install with no runtime prompt. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FINE is required, not a nicety. Coarse was assumed "enough for a 150 m
         geofence"; it is not. Android 12+ fuzzes ACCESS_COARSE_LOCATION to a
         ~1-2 km grid that is re-randomised periodically, so a coarse fix taken
         at home routinely lands outside a 150 m fence, which reads as AWAY
         and restores every app the geofence exists to hide. Measured 2026-08-14:
         only COARSE was held, and the phone alternated between blocking nothing
         at home and blocking everything at the office.
         COARSE stays declared so a partial grant still yields a (fuzzed) fix
         rather than none at all. Both are self-granted by the device owner in
         DevicePolicyBridge.grantLocationPermissions(); background access is
         what makes the gate work while the screen is off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Needed to enumerate installed packages for the allowlist sweep. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:label="focus_owner"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Device admin component. Declaring it makes device-owner
             provisioning possible; it applies no restrictions on its own.
             BIND_DEVICE_ADMIN must be held by the system, and the receiver must
             be exported, or `dpm set-device-owner` cannot find it. -->
        <receiver
            android:name=".FocusDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Applies one enforcement pass, then schedules the next. Not
             resident: the alarm brings it back. -->
        <service
            android:name=".EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse|location">
            <!-- "location" as well as "specialUse": the pass actively requests
                 a fix, and background location delivery is throttled to a few
                 times an hour unless it happens under a location-typed
                 foreground service. Without it the request usually times out,
                 which fails closed and blocks everything. -->

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Applies the device-owner focus policy at scheduled times" />
        </service>

        <receiver
            android:name=".EnforcementAlarmReceiver"
            android:exported="false" />

        <!-- directBootAware so LOCKED_BOOT_COMPLETED can re-arm the schedule
             before the user unlocks; BOOT_COMPLETED alone does not arrive
             until first unlock. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- Installing over the app cancels its pending alarms, so
                     without this an `adb install -r` silently stops
                     enforcement until someone opens the app. Measured
                     2026-08-14: an install at 13:31 dropped the 13:34 alarm,
                     and the chain only resumed because the app was launched.
                     A deploy during curfew would otherwise leave the curfew
                     allowlist applied indefinitely. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
