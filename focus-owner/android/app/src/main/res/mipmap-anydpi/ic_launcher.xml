<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback for API 24-25, which predate adaptive icons (minSdk is 24, so
  mipmap-anydpi-v26 alone would leave those two API levels with an unresolved
  @mipmap/ic_launcher — the same AAPT failure this is fixing, just narrower).
  Same charcoal field and glyph, composed as a plain layer-list; the glyph
  layer is generated by tool/generate_launcher_vector.py.

  <adaptive-icon> is NOT usable here: AAPT requires sdk >= 26 for that element,
  which is exactly what mipmap-anydpi-v26 is for.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
