<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon. The layers are generated from the shared icon family
  by tool/generate_launcher_vector.py — see that script for why focus_owner
  uses vector drawables rather than the family's usual PNG mipmaps.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
