[Unit]
Description=Phone focus mode auto sync
After=network.target

[Service]
Type=oneshot
# The orchestrator moved out of testsAndMisc when phone-focus-mode was
# extracted; the old scripts/run_all path no longer exists. `auto` is a logged
# no-op (exit 0) unless an enrolled, rooted phone is connected.
ExecStart=%h/src/phone-focus-mode/run_phone.sh auto
StandardOutput=journal
StandardError=journal
