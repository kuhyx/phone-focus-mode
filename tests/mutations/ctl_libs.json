{
  "test": "lib/tests/test_ctl_libs.sh",
  "timeout": 300,
  "mutations": [
    {
      "file": "ctl_curfew.sh",
      "find": "[ \"$now\" -ge \"$start\" ] || [ \"$now\" -lt \"$end\" ]",
      "replace": "[ \"$now\" -ge \"$start\" ] && [ \"$now\" -lt \"$end\" ]",
      "describe": "break the midnight-wrapping curfew window"
    },
    {
      "file": "ctl_curfew.sh",
      "find": "case \"$now\" in '' | *[!0-9]*) return 1 ;; esac",
      "replace": "case \"$now\" in '' | *[!0-9]*) return 0 ;; esac",
      "describe": "fail CLOSED on a broken clock instead of open"
    },
    {
      "file": "ctl_curfew.sh",
      "find": "while [ \"${n#0}\" != \"$n\" ] && [ \"${#n}\" -gt 1 ]; do n=\"${n#0}\"; done",
      "replace": ":",
      "describe": "stop stripping leading zeros (octal parse)"
    },
    {
      "file": "ctl_curfew.sh",
      "find": "\ttouch \"$CURFEW_FORCE_FILE\"",
      "replace": "\t:",
      "describe": "curfew-test-on stops creating the force file"
    },
    {
      "file": "ctl_curfew.sh",
      "find": "cmd_curfew_off() {\n\ttouch \"$CURFEW_OVERRIDE_FILE\"",
      "replace": "cmd_curfew_off() {\n\t:",
      "describe": "curfew-off stops creating the 2am escape hatch"
    },
    {
      "file": "ctl_curfew.sh",
      "find": "cmd_curfew_on() {\n\trm -f \"$CURFEW_OVERRIDE_FILE\"",
      "replace": "cmd_curfew_on() {\n\t:",
      "describe": "curfew-on stops clearing the override"
    },
    {
      "file": "ctl_tether.sh",
      "find": "\ttouch \"$TETHER_FORCE_FILE\"",
      "replace": "\t:",
      "describe": "tether-test-on stops creating the force file"
    },
    {
      "file": "ctl_tether.sh",
      "find": "cmd_tether_test_off() {\n\trm -f \"$TETHER_FORCE_FILE\"",
      "replace": "cmd_tether_test_off() {\n\t:",
      "describe": "tether-test-off stops clearing the force file"
    },
    {
      "file": "ctl_dns.sh",
      "find": "if iptables -L \"$DNS_IPT_CHAIN\" >/dev/null 2>&1; then",
      "replace": "if ! iptables -L \"$DNS_IPT_CHAIN\" >/dev/null 2>&1; then",
      "describe": "invert the v4 DNS chain presence check"
    },
    {
      "file": "ctl_dns.sh",
      "find": "if ip6tables -L \"$DNS_IPT_CHAIN\" >/dev/null 2>&1; then",
      "replace": "if ! ip6tables -L \"$DNS_IPT_CHAIN\" >/dev/null 2>&1; then",
      "describe": "invert the v6 DNS chain presence check"
    },
    {
      "file": "ctl_dns.sh",
      "find": "${mode:-<unset>}",
      "replace": "${mode}",
      "describe": "render an unset private DNS mode as blank"
    },
    {
      "file": "ctl_hosts.sh",
      "find": "cmd_hosts_start() {\n\tlocal pid\n\tpid=\"$(hosts_enforcer_pid)\"\n\tif [ -n \"$pid\" ]; then",
      "replace": "cmd_hosts_start() {\n\tlocal pid\n\tpid=\"$(hosts_enforcer_pid)\"\n\tif [ -z \"$pid\" ]; then",
      "describe": "invert the hosts already-running guard"
    },
    {
      "file": "ctl_workout.sh",
      "find": "if [ ! -x \"$WORKOUT_SQLITE3_BIN\" ]; then",
      "replace": "if [ -x \"$WORKOUT_SQLITE3_BIN\" ]; then",
      "describe": "invert the sqlite3 precondition"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "local mode=\"unknown\"",
      "replace": "local mode=\"\"",
      "describe": "report an absent mode as blank rather than unknown"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "echo \"Location: unavailable\"",
      "replace": ":",
      "describe": "stay silent when no GPS fix is available"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "R=6371000",
      "replace": "R=1",
      "describe": "wrong Earth radius in cmd_status's Haversine (awk kcov cannot see)"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "pm enable \"$pkg\" >/dev/null 2>&1 && count=$((count + 1))",
      "replace": "count=$((count + 1))",
      "describe": "count apps as restored without enabling them"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "\t\t: >\"$DISABLED_APPS_FILE\"",
      "replace": "\t\t:",
      "describe": "leave the disabled record in place after restoring"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "\ttouch \"$RECHECK_TRIGGER\"",
      "replace": "\t:",
      "describe": "recheck stops writing the trigger"
    },
    {
      "file": "ctl_daemon.sh",
      "find": "echo \"Daemon not running - start it first with: focus_ctl.sh start\"\n\t\treturn 1",
      "replace": "echo \"Daemon not running - start it first with: focus_ctl.sh start\"",
      "describe": "recheck continues after reporting no daemon"
    },
    {
      "file": "ctl_usage.sh",
      "find": "\t\t*.*) ;;",
      "replace": "\t\t*) ;;",
      "describe": "accept non-dotted tokens as package names"
    },
    {
      "file": "ctl_usage.sh",
      "find": "\t\tcase \"$pkg\" in\n\t\t*[!A-Za-z0-9._]*) continue ;;\n\t\tesac",
      "replace": "\t\t:",
      "describe": "accept packages containing illegal characters"
    }
  ]
}
