# Carried over from testsAndMisc, where these two settings are what let
# shellcheck run with no --severity filter: every finding, including info- and
# style-level, is a failure.

# Follow `source`d files so SC1091 is satisfied by pointing at the real file
# rather than silenced.
external-sources=true

# Resolve `source` targets relative to the sourcing script's own directory.
# Every site here is `source "$SCRIPT_DIR/../lib/mtk_common.sh"`, and shellcheck
# cannot expand $SCRIPT_DIR - but with SCRIPTDIR on the search path the
# `# shellcheck source=../lib/mtk_common.sh` directive at the call site resolves
# to the real file, so the sourced code is actually analysed instead of skipped.
source-path=SCRIPTDIR
